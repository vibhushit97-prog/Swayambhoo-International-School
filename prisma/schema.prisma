// Prisma schema for Swayambhoo International School
// Phase 2: CMS + Database + Administration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  CLOSED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// Admin Users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Central School Profile
model SchoolProfile {
  id                   String   @id @default("school-profile-main")
  name                 String   @default("Swayambhoo International School")
  tagline              String   @default("LEARN. EXPLORE. CREATE. LEAD.")
  motto                String   @default("LEARN • GROW • LEAD")
  campusMotto          String   @default("Discipline Today, Leadership Tomorrow")
  description          String
  addressStreet        String
  addressLocality      String   @default("Wazirganj")
  addressCity          String   @default("Gaya")
  addressState         String   @default("Bihar")
  addressPincode       String   @default("805131")
  phone                String   @default("+91 92412 18844")
  whatsapp             String   @default("+91 96614 48541")
  email                String   @default("info@swayambhooschool.com")
  admissionsEmail      String   @default("admissions@swayambhooschool.com")
  logoUrl              String   @default("/logo/swayambhoo-logo.svg")
  heroImageUrl         String   @default("/images/hero/swayambhoo-hero-facade.jpg")
  socialLinks          Json?
  admissionCtaTitle    String   @default("Admissions Open for Academic Session 2026–2027")
  admissionCtaSubtitle String   @default("Secure your child's future at Gaya's premier educational campus.")
  footerText           String   @default("Empowering students through academic distinction, modern technology, and values-driven character building.")
  updatedAt            DateTime @updatedAt
}

// Academic Stages & Programs
model AcademicStage {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  classes      String
  ageRange     String
  description  String
  imageUrl     String?
  displayOrder Int              @default(0)
  status       PublishStatus    @default(PUBLISHED)
  streams      AcademicStream[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Configurable Streams (e.g. for Senior Secondary)
model AcademicStream {
  id           String        @id @default(cuid())
  stageId      String
  stage        AcademicStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String
  subjects     String[]
  isOffered    Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([stageId, slug])
}

// School Facilities
model Facility {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  tagline      String
  category     String
  description  String
  imageUrl     String
  features     String[]
  displayOrder Int           @default(0)
  isFeatured   Boolean       @default(false)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Gallery Categories & Images
model GalleryCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  sortOrder   Int            @default(0)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
}

model GalleryImage {
  id          String           @id @default(cuid())
  title       String
  description String?
  altText     String
  imageUrl    String
  storageKey  String?
  categoryId  String?
  category    GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isConcept   Boolean          @default(false)
  sortOrder   Int              @default(0)
  status      PublishStatus    @default(PUBLISHED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Announcements & News
model Announcement {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       String
  featuredImage String?
  status        PublishStatus @default(PUBLISHED)
  publishDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Events Calendar
model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String        @default("Swayambhoo Campus, Wazirganj")
  imageUrl    String?
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Phase 2 Admissions Enquiries CRM
model AdmissionEnquiry {
  id              String        @id @default(cuid())
  studentName     String
  parentName      String
  phone           String
  whatsapp        String?
  email           String
  currentClass    String
  applyingFor     String
  academicSession String
  message         String?
  status          EnquiryStatus @default(NEW)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Contact Messages
model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  phone     String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Site Settings
model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// Media Assets (Object Storage Tracking)
model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  filename  String
  url       String
  mimeType  String
  size      Int
  provider  String   @default("local")
  altText   String?
  createdAt DateTime @default(now())
}
