// Prisma schema for Swayambhoo International School
// Phase 2: CMS + Database + Administration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum EnquiryStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  CONVERTED
  CLOSED
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  CLOSED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEW_CONFIRMED
  RESCHEDULE_REQUESTED
  INTERVIEW_COMPLETED
  SELECTED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  RESCHEDULE_REQUESTED
  COMPLETED
  CANCELLED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Admin Users
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Central School Profile
model SchoolProfile {
  id                   String   @id @default("school-profile-main")
  name                 String   @default("Swayambhoo International School")
  tagline              String   @default("LEARN. EXPLORE. CREATE. LEAD.")
  motto                String   @default("LEARN • GROW • LEAD")
  campusMotto          String   @default("Discipline Today, Leadership Tomorrow")
  description          String
  addressStreet        String
  addressLocality      String   @default("Wazirganj")
  addressCity          String   @default("Gaya")
  addressState         String   @default("Bihar")
  addressPincode       String   @default("805131")
  phone                String   @default("+91 92412 18844")
  whatsapp             String   @default("+91 96614 48541")
  email                String   @default("info@swayambhooschool.com")
  admissionsEmail      String   @default("admissions@swayambhooschool.com")
  logoUrl              String   @default("/logo/swayambhoo-logo.svg")
  heroImageUrl         String   @default("/images/hero/swayambhoo-hero-facade.jpg")
  socialLinks          Json?
  admissionCtaTitle    String   @default("Admissions Open for Academic Session 2026–2027")
  admissionCtaSubtitle String   @default("Secure your child's future at Gaya's premier educational campus.")
  footerText           String   @default("Empowering students through academic distinction, modern technology, and values-driven character building.")
  updatedAt            DateTime @updatedAt
}

// Academic Stages & Programs
model AcademicStage {
  id           String           @id @default(cuid())
  slug         String           @unique
  title        String
  classes      String
  ageRange     String
  description  String
  imageUrl     String?
  displayOrder Int              @default(0)
  status       PublishStatus    @default(PUBLISHED)
  streams      AcademicStream[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// Configurable Streams (e.g. for Senior Secondary)
model AcademicStream {
  id           String        @id @default(cuid())
  stageId      String
  stage        AcademicStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name         String
  slug         String
  description  String
  subjects     String[]
  isOffered    Boolean       @default(false)
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([stageId, slug])
}

// School Facilities
model Facility {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  tagline      String
  category     String
  description  String
  imageUrl     String
  features     String[]
  displayOrder Int           @default(0)
  isFeatured   Boolean       @default(false)
  status       PublishStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// Gallery Categories & Images
model GalleryCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  description String?
  sortOrder   Int            @default(0)
  images      GalleryImage[]
  createdAt   DateTime       @default(now())
}

model GalleryImage {
  id          String           @id @default(cuid())
  title       String
  description String?
  altText     String
  imageUrl    String
  storageKey  String?
  categoryId  String?
  category    GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isConcept   Boolean          @default(false)
  sortOrder   Int              @default(0)
  status      PublishStatus    @default(PUBLISHED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

// Announcements & News
model Announcement {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  summary       String
  content       String
  featuredImage String?
  status        PublishStatus @default(PUBLISHED)
  publishDate   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Events Calendar
model Event {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String        @default("Swayambhoo Campus, Wazirganj")
  imageUrl    String?
  status      PublishStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Phase 2 Admissions Enquiries CRM
model AdmissionEnquiry {
  id              String        @id @default(cuid())
  studentName     String
  parentName      String
  phone           String
  whatsapp        String?
  email           String
  currentClass    String
  applyingFor     String
  academicSession String
  message         String?
  status          EnquiryStatus @default(NEW)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

// Contact Messages
model ContactMessage {
  id        String        @id @default(cuid())
  fullName  String
  phone     String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(UNREAD)
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

// Site Settings
model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// Media Assets (Object Storage Tracking)
model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  filename  String
  url       String
  mimeType  String
  size      Int
  provider  String   @default("local")
  altText   String?
  createdAt DateTime @default(now())
}

// ==========================================
// Phase 3: Recruitment & Career Portal
// ==========================================

model JobPosition {
  id               String               @id @default(cuid())
  title            String
  code             String?
  department       String               @default("Academics")
  subjects         String[]
  minQualification String
  minExperience    Int                  @default(0)
  vacancies        Int                  @default(1)
  employmentType   String               @default("Full Time")
  description      String?
  responsibilities String?
  requirements     String?
  deadline         DateTime?
  isActive         Boolean              @default(true)
  displayOrder     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  applications     TeacherApplication[]

  @@index([isActive])
  @@index([department])
}

model RecruitmentSequence {
  id            String   @id @default("recruitment_app_seq")
  year          Int      @default(2026)
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model TeacherApplication {
  id                   String                     @id @default(uuid())
  applicationNumber    String                     @unique
  fullName             String
  dateOfBirth          DateTime
  gender               String?
  mobile               String
  whatsapp             String?
  email                String
  address              String
  city                 String?
  state                String?
  pincode              String?
  profilePhoto         String?
  positionId           String?
  position             JobPosition?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  otherPosition        String?
  subject              String?
  preferredClasses     String?
  employmentType       String                     @default("Full Time")
  expectedSalary       String?
  currentSalary        String?
  noticePeriod         String?
  willingToRelocate    Boolean                    @default(false)
  totalExperienceYears Float                      @default(0)
  personalStatement    String?
  teachingPhilosophy   String?
  status               ApplicationStatus          @default(NEW)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  educationRecords     EducationRecord[]
  experienceRecords    ExperienceRecord[]
  skills               Skill[]
  languages            LanguageSkill[]
  documents            ApplicationDocument[]
  statusHistory        ApplicationStatusHistory[]
  interviews           Interview[]
  adminNotes           AdminNote[]
  emailNotifications   EmailNotification[]

  @@index([applicationNumber])
  @@index([email])
  @@index([mobile])
  @@index([status])
  @@index([positionId])
  @@index([createdAt])
}

model EducationRecord {
  id                 String             @id @default(cuid())
  applicationId      String
  application        TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  qualification      String
  otherQualification String?
  institution        String
  boardOrUniversity  String
  year               Int
  percentageOrCgpa   String
  specialization     String?
  createdAt          DateTime           @default(now())

  @@index([applicationId])
}

model ExperienceRecord {
  id               String             @id @default(cuid())
  applicationId    String
  application      TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  institution      String
  designation      String
  subject          String?
  classesTaught    String?
  startDate        DateTime
  endDate          DateTime?
  currentlyWorking Boolean            @default(false)
  responsibilities String?
  createdAt        DateTime           @default(now())

  @@index([applicationId])
}

model Skill {
  id            String             @id @default(cuid())
  applicationId String
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skillName     String
  createdAt     DateTime           @default(now())

  @@index([applicationId])
  @@index([skillName])
}

model LanguageSkill {
  id            String             @id @default(cuid())
  applicationId String
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  language      String
  proficiency   String
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model ApplicationDocument {
  id            String             @id @default(cuid())
  applicationId String
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentType  String
  filename      String
  storageKey    String
  mimeType      String
  fileSize      Int
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}

model ApplicationStatusHistory {
  id             String             @id @default(cuid())
  applicationId  String
  application    TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStatus ApplicationStatus?
  newStatus      ApplicationStatus
  changedBy      String?
  reason         String?
  createdAt      DateTime           @default(now())

  @@index([applicationId])
}

model Interview {
  id                     String                   @id @default(cuid())
  applicationId          String
  application            TeacherApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewDate          DateTime
  interviewTime          String
  interviewMode          String
  venue                  String?
  meetingLink            String?
  interviewer            String?
  additionalInstructions String?
  confirmationToken      String                   @unique
  status                 InterviewStatus          @default(SCHEDULED)
  rescheduleReason       String?
  scheduledBy            String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  statusHistory          InterviewStatusHistory[]

  @@index([applicationId])
  @@index([confirmationToken])
  @@index([status])
}

model InterviewStatusHistory {
  id             String          @id @default(cuid())
  interviewId    String
  interview      Interview       @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  previousStatus InterviewStatus?
  newStatus      InterviewStatus
  changedBy      String?
  notes          String?
  createdAt      DateTime        @default(now())

  @@index([interviewId])
}

model EmailNotification {
  id            String              @id @default(cuid())
  applicationId String?
  application   TeacherApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  recipient     String
  subject       String
  emailType     String
  status        EmailStatus         @default(PENDING)
  attemptCount  Int                 @default(0)
  errorMessage  String?
  metadata      Json?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())

  @@index([applicationId])
  @@index([status])
}

model AdminNote {
  id            String             @id @default(cuid())
  applicationId String
  application   TeacherApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  adminName     String
  content       String
  createdAt     DateTime           @default(now())

  @@index([applicationId])
}
